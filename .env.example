# FleetPulse environment — copy to .env (git-ignored) before running.
#   cp .env.example .env   (or `make up`, which bootstraps it automatically)
# Only this .example file is committed; never commit a real .env. No secrets here.
#
# Vars are seeded across all steps so later work doesn't have to edit Compose;
# Step 1 actually USES only the Postgres/Redis pieces (infra-only Compose). The
# rest are placeholders the app/simulator/web services wire up in later steps.

# --- TimescaleDB (used by the timescaledb Compose service in Step 1) ---
POSTGRES_USER=fleetpulse
POSTGRES_PASSWORD=fleetpulse
POSTGRES_DB=fleetpulse
POSTGRES_PORT=5432

# Async SQLAlchemy/asyncpg URL the backend uses (host = Compose service name).
DATABASE_URL=postgresql+asyncpg://fleetpulse:fleetpulse@timescaledb:5432/fleetpulse

# DB connection pool (sized deliberately; back-pressure uses the acquire timeout). [Step 3/4]
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5

# --- Redis (used by the redis Compose service in Step 1) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Ingest back-pressure caps (§10.9) [Step 4 / 9a] ---
MAX_BATCH_READINGS=500
MAX_BODY_BYTES=1048576
BROKER_QUEUE_DEPTH_THRESHOLD=10000

# --- API / CORS (§ Step 3) ---
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
# Device-auth API key on POST /telemetry — M7 only; left blank/unenforced in v1.
INGEST_API_KEY=

# --- Frontend (Vite) [Step 11] ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/fleet

# --- Simulator knobs [Step 5] ---
SIM_VEHICLE_COUNT=20
SIM_EMIT_INTERVAL_SECONDS=2
SIM_BATCH_SIZE=10
SIM_API_BASE_URL=http://api:8000/api/v1
